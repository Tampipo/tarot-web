# ---------------------------------------------------------------------------
# Copy to .env and fill in. docker-compose reads this file.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_DB=tarot
POSTGRES_USER=tarot
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql://tarot:changeme_in_production@postgres:5432/tarot

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# App
PORT=3000
NODE_ENV=production

# Public base URL of the API (the OIDC redirect_uri is API_PUBLIC_URL/auth/oidc/callback)
API_PUBLIC_URL=http://localhost:8080/api
# Where to send the browser after a successful login / SSO
WEB_ORIGIN=http://localhost:8080

# Auth
#   local  — email + password stored in Postgres
#   oidc   — single-sign-on only
#   both   — offer both on the login screen (default)
AUTH_MODE=both
# Set to false to lock down password self-registration (local mode)
ALLOW_SIGNUP=true

# --- OIDC (only needed when AUTH_MODE is oidc or both) ----------------------
# e.g. https://auth.example.com/realms/main  (must expose /.well-known/openid-configuration)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Space-separated scopes; openid is always required
OIDC_SCOPES=openid profile email
