# ---------------------------------------------------------------------------
# Copy to .env and fill in. docker-compose reads this file.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_DB=tarot
POSTGRES_USER=tarot
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql://tarot:changeme_in_production@postgres:5432/tarot

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# App
PORT=3000
NODE_ENV=production
# Host port the web UI is published on (docker-compose only)
WEB_PORT=8080

# Registration is open by default; set false to freeze sign-ups entirely.
# New accounts are always created *pending* and need admin approval to log in.
ALLOW_SIGNUP=true

# Bootstrap admin. On first start (when no admin exists yet) an active admin
# account is created from these. Promote a real user to admin, then you can
# delete this one — it won't be recreated while another admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
