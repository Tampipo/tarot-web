{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "isolatedModules": false
  },
  // Resolves @tarot/shared via node_modules to packages/shared/dist — so shared
  // must be built first (npm run build:shared, which lint/build/Docker all do).
  "include": ["src"]
}
