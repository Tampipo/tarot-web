generator client {
  provider = "prisma-client-js"
  // native = local dev; linux-musl-openssl-3.0.x = the node:20-alpine runtime image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// An authenticated account (email + password).
//   role   — "admin" | "member". Admins approve registrations and manage users.
//   status — "pending" | "active". New sign-ups start pending and cannot log in
//            until an admin approves them (keeps strangers out).
// The bootstrap admin (from ADMIN_EMAIL/ADMIN_PASSWORD) is created active.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member")
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  createdGames Game[] @relation("createdBy")
}

// A person who sits at the tarot table. Decoupled from User on purpose: you
// score games for friends who never log in. Scores are always aggregated from
// GamePlayer rows, never stored as a running total (the old CSV did the latter
// and drifted).
model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  gamePlayers GamePlayer[]
  takenGames  Game[]       @relation("taker")
  partneredIn Game[]       @relation("partner")
}

// One scored deal. baseScore is the deal's value to the attack; the signed
// per-player results live in GamePlayer and always sum to zero.
model Game {
  id          String   @id @default(cuid())
  playedAt    DateTime @default(now())
  contract    String
  oudlers     Int
  pointsMade  Int
  // Seats at the table (3–5). Stored because guest seats produce no GamePlayer
  // row, so players.length alone would under-report the real table size.
  numPlayers  Int
  selfCalled  Boolean // taker played alone (no partner)
  petitAuBout String   @default("none") // none | attack | defense
  // Size only: the bonus always goes to whichever camp won the deal.
  poignee     String   @default("none") // none | simple | double | triple
  misere      String   @default("none") // none | attack | defense
  baseScore   Int

  takerId     String
  taker       Player  @relation("taker", fields: [takerId], references: [id])
  partnerId   String?
  partner     Player? @relation("partner", fields: [partnerId], references: [id])

  createdById String?
  // Keep the game if its author is later deleted — history outlives accounts.
  createdBy   User?   @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  players GamePlayer[]

  @@index([playedAt])
}

// A registered player's signed result in one game — the single source of truth
// for every leaderboard and statistic. Guest seats are deliberately absent:
// they take part in the scoring maths but are never recorded.
model GamePlayer {
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  score    Int

  @@id([gameId, playerId])
  @@index([playerId])
}
